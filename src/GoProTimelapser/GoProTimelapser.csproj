<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>GoProTimelapser</AssemblyName>
    <RootNamespace>GoProTimelapser</RootNamespace>
    <Version>1.0.0</Version>
    <Product>GoPro Timelapser</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Single self-contained exe, no .NET install or admin needed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- ffmpeg.exe is downloaded by build.ps1 / CI and embedded so the app is fully offline -->
  <ItemGroup Condition="Exists('ffmpeg\ffmpeg.exe')">
    <EmbeddedResource Include="ffmpeg\ffmpeg.exe" LogicalName="ffmpeg.exe" />
  </ItemGroup>

</Project>
